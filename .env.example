# --- WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup) ---
WA_VERIFY_TOKEN=choose-any-string
WA_APP_SECRET=            # App settings > Basic > App secret (enables signature check)
WA_ACCESS_TOKEN=          # System user permanent token
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
WA_REMINDER_TEMPLATE=appointment_reminder   # approved template with 3 body params
WA_TEMPLATE_LANG=en

# --- Bot ---
BOT_MODE=booking          # booking | ai
CLINIC_NAME=Smile Dental Clinic
SLOT_HOLD_MINUTES=5
RUN_SCHEDULER=1

# --- AI receptionist (optional; offline mode without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CRM (optional): HubSpot/GHL/Make/Zapier catch hook or your endpoint ---
CRM_WEBHOOK_URL=

# --- Storage ---
DATABASE_URL=sqlite:///./demo.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/whatsapp
